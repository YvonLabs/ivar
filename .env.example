# IVAR Environment Configuration
# Copy this to .env and fill in your values

# Organisation
ORG_NAME=YourOrg
ORG_STACK=github,docker,postgresql,python

# Database
DATABASE_URL=sqlite:////var/www/ivar/backend/ivar.db

# AI Triage (optional — rule-based triage used if not set)
# AI_PROVIDER=claude
# AI_API_KEY=your-key-here
# AI_MODEL=claude-sonnet-4-20250514

# Notifications (optional)
# SLACK_WEBHOOK=https://hooks.slack.com/services/...
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
