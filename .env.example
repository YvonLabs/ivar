# IVAR Environment Configuration
# Copy this to .env and fill in your values

# Organisation
ORG_NAME=YourOrg
ORG_STACK=github,docker,python

# Database
# Docker: sqlite:////app/data/ivar.db
# Manual install: sqlite:///./ivar.db
DATABASE_URL=sqlite:////app/data/ivar.db

# Auth
# Default admin credentials — you will be prompted to change your password on first login
IVAR_ADMIN_USER=admin
IVAR_ADMIN_PASSWORD=Valhalla@12!

# AI Triage (optional — rule-based triage used if not set)
# Supported: claude, openai, ollama
# AI_PROVIDER=claude
# AI_API_KEY=your-key-here
# AI_MODEL=claude-sonnet-4-20250514

# Notifications (optional)
# SLACK_WEBHOOK=https://hooks.slack.com/services/...
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/...

# Optional feed API keys
# OTX_API_KEY=your-otx-key
# HIBP_API_KEY=your-hibp-key
# SHODAN_API_KEY=your-shodan-key